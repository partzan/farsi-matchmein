# ── Frontend (Vite) — safe to expose ─────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Comma-separated emails allowed to open /create-event (required for admin create).
# Example: VITE_ADMIN_EMAILS=you@company.com,ops@company.com
VITE_ADMIN_EMAILS=

# Enable "Generate image" on create-event (calls Edge Function generate-event-image).
# Upload still works when this is false/unset. Set true only after edge secrets are set.
VITE_IMAGE_GENERATOR_ENABLED=false

# ── Image generator (Edge Function secrets — NOT VITE_*) ─────────────────────
# Required before generate works (Dashboard → Project Settings → Edge Functions → Secrets):
#   IMAGE_GENERATOR_API_KEY   — or OPENAI_API_KEY as fallback
#   IMAGE_GENERATOR_PROVIDER  — openai (default) | custom
# Optional:
#   IMAGE_GENERATOR_MODEL=dall-e-3
#   IMAGE_GENERATOR_API_URL=https://api.openai.com/v1/images/generations
# CLI:
#   npx supabase secrets set --project-ref sfbofhyqwmwvgjkndkdg IMAGE_GENERATOR_API_KEY=sk-... IMAGE_GENERATOR_PROVIDER=openai
# Deploy:
#   npx supabase functions deploy generate-event-image --project-ref sfbofhyqwmwvgjkndkdg
#
# Provider: openai (default) | custom (requires IMAGE_GENERATOR_API_URL)

# ── Kavenegar OTP — DO NOT put the API key in VITE_* ─────────────────────────
# Set these as Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets
# or CLI: supabase secrets set ...). Never commit the real key.
#
#   KAVENEGAR_API_KEY=your_kavenegar_api_key
#   KAVENEGAR_TEMPLATE=verify
#
# 1) Create a Verify template in Kavenegar panel (English name, e.g. "verify")
#    with %token in the SMS body, example:
#      کد ورود های‌ایونت: %token
# 2) Run SQL: supabase/migrations/20260726_otp_challenges.sql
# 3) Deploy functions:
#      supabase functions deploy otp-send
#      supabase functions deploy otp-verify
# 4) Set secrets:
#      supabase secrets set KAVENEGAR_API_KEY=xxxx KAVENEGAR_TEMPLATE=verify
