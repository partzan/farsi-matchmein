# ── Frontend (Vite) — safe to expose ─────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Comma-separated emails allowed to open /create-event (required for admin create).
# Example: VITE_ADMIN_EMAILS=you@company.com,ops@company.com
VITE_ADMIN_EMAILS=

# Frontend flag: ONLY toggles the "Generate with AI" button on create-event step 5.
# The image section (upload + generate choices) ALWAYS shows for admins — no env needed
# for upload. Edge secrets (OpenRouter / OpenAI) do NOT control UI visibility.
# Requires a Vite restart after changing. Unset/true = Generate enabled; false = disabled.
VITE_IMAGE_GENERATOR_ENABLED=true

# ── Image generator (Edge Function secrets — NOT VITE_*) ─────────────────────
# These unlock the Generate button's backend only. They never add/remove the image UI.
# Dashboard → Project Settings → Edge Functions → Secrets, or CLI below.
#
# Required:
#   IMAGE_GENERATOR_API_KEY   — OpenAI / OpenRouter / compatible key
#     (fallbacks also read: OPENROUTER_API_KEY, OPENAI_API_KEY)
#   IMAGE_GENERATOR_PROVIDER  — openai (default) | openrouter | custom
#
# OpenRouter example:
#   IMAGE_GENERATOR_PROVIDER=openrouter
#   IMAGE_GENERATOR_API_KEY=sk-or-v1-...
#   IMAGE_GENERATOR_MODEL=openai/dall-e-3
#   (API URL defaults to https://openrouter.ai/api/v1/images/generations)
#
# OpenAI example:
#   IMAGE_GENERATOR_PROVIDER=openai
#   IMAGE_GENERATOR_API_KEY=sk-...
#   IMAGE_GENERATOR_MODEL=dall-e-3
#
# Optional:
#   IMAGE_GENERATOR_API_URL=...   (override; required for provider=custom)
#   IMAGE_GENERATOR_HTTP_REFERER / IMAGE_GENERATOR_APP_TITLE — OpenRouter headers
#     (edge defaults to https://www.r359.ir and HiEvent if unset)
# CLI:
#   npx supabase secrets set --project-ref sfbofhyqwmwvgjkndkdg IMAGE_GENERATOR_API_KEY=sk-... IMAGE_GENERATOR_PROVIDER=openrouter IMAGE_GENERATOR_MODEL=openai/dall-e-3
# Deploy:
#   npx supabase functions deploy generate-event-image --project-ref sfbofhyqwmwvgjkndkdg

# ── Kavenegar OTP — DO NOT put the API key in VITE_* ─────────────────────────
# Set these as Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets
# or CLI: supabase secrets set ...). Never commit the real key.
#
#   KAVENEGAR_API_KEY=your_kavenegar_api_key
#   KAVENEGAR_TEMPLATE=verify
#
# 1) Create a Verify template in Kavenegar panel (English name, e.g. "verify")
#    with %token in the SMS body, example:
#      کد ورود های‌ایونت: %token
# 2) Run SQL: supabase/migrations/20260726_otp_challenges.sql
# 3) Deploy functions:
#      supabase functions deploy otp-send
#      supabase functions deploy otp-verify
# 4) Set secrets:
#      supabase secrets set KAVENEGAR_API_KEY=xxxx KAVENEGAR_TEMPLATE=verify
